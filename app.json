{
  "package_id": "com.igarashi.chorusprompter",
  "edition": "202601",
  "name": "合唱プロンプター",
  "version": "0.1.0",
  "min_app_version": "2.2.9",
  "min_sdk_version": "0.0.14",
  "entrypoint": "index.html",
