{
  "name": "evenhub-text-heavy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "release": "bash scripts/release.sh",
    "simulate": "evenhub-simulator http://localhost:5173",
    "postinstall": "test -f node_modules/@evenrealities/evenhub-simulator/bin/index.js && ln -sf ../@evenrealities/evenhub-simulator/bin/index.js node_modules/.bin/evenhub-simulator || true"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  }
}
